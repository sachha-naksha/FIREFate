    "import numpy as np\n",
    "from scipy.signal import find_peaks\n",
    "\n",
    "# Create x-axis positions (pseudotime values)\n",
    "x = np.array([pseudotime_values_of_windows[i] for i in PB_post_bifurcation_window_indices])\n",
    "\n",
    "# Store extrema info\n",
    "extrema_info = {}\n",
    "extrema_pseudotimes = {}\n",
    "\n",
    "for state in df_plot.index:\n",
    "    y = df_plot.loc[state].values\n",
    "    \n",
    "    # Find local maxima indices\n",
    "    maxima_idx, _ = find_peaks(y, prominence=10, distance=3)\n",
    "    \n",
    "    # Find local minima indices (invert signal)\n",
    "    minima_idx, _ = find_peaks(-y, prominence=10, distance=3)\n",
    "    \n",
    "    extrema_info[state] = {\n",
    "        'maxima_window_idx': maxima_idx,\n",
    "        'maxima_pseudotime': x[maxima_idx],\n",
    "        'maxima_count': y[maxima_idx],\n",
    "        'minima_window_idx': minima_idx,\n",
    "        'minima_pseudotime': x[minima_idx],\n",
    "        'minima_count': y[minima_idx]\n",
    "    }\n",
    "    \n",
    "    # Create tuple of (maxima_pseudotimes, minima_pseudotimes)\n",
    "    extrema_pseudotimes[state] = {\n",
    "        'maxima': tuple(x[maxima_idx]),\n",
    "        'minima': tuple(x[minima_idx]),\n",
    "        'all': tuple(sorted(np.concatenate([x[maxima_idx], x[minima_idx]])))\n",
    "    }\n",
    "\n",
    "# Create summary dataframe\n",
    "summary_data = []\n",
    "for state in df_plot.index:\n",
    "    for idx, pt, cnt in zip(extrema_info[state]['maxima_window_idx'],\n",
    "                            extrema_info[state]['maxima_pseudotime'],\n",
    "                            extrema_info[state]['maxima_count']):\n",
    "        summary_data.append({\n",
    "            'state': state,\n",
    "            'type': 'maximum',\n",
    "            'window_idx': idx,\n",
    "            'pseudotime': pt,\n",
    "            'count': cnt\n",
    "        })\n",
    "    for idx, pt, cnt in zip(extrema_info[state]['minima_window_idx'],\n",
    "                            extrema_info[state]['minima_pseudotime'],\n",
    "                            extrema_info[state]['minima_count']):\n",
    "        summary_data.append({\n",
    "            'state': state,\n",
    "            'type': 'minimum',\n",
    "            'window_idx': idx,\n",
    "            'pseudotime': pt,\n",
    "            'count': cnt\n",
    "        })\n",
    "\n",
    "# Print extrema_pseudotimes dictionary\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"EXTREMA PSEUDOTIMES DICTIONARY\")\n",
    "print(\"=\" * 70)\n",
    "for state, vals in extrema_pseudotimes.items():\n",
    "    print(f\"\\n'{state}': {{\")\n",
    "    print(f\"    'maxima': {vals['maxima']},\")\n",
    "    print(f\"    'minima': {vals['minima']},\")\n",
    "    print(f\"    'all': {vals['all']},\")\n",
    "    if 'emergence' in vals:\n",
    "        print(f\"    'emergence': {vals['emergence']:.5f}\")\n",
    "    print(\"}\")\n",
    "\n",
    "# Visualization\n",
    "fig, ax = plt.subplots(figsize=(15, 8))\n",
    "\n",
    "for state in df_plot.index:\n",
    "    y = df_plot.loc[state].values\n",
    "    ax.plot(x, y, label=state, color=colors_cell_count[state], linewidth=2)\n",
    "    ax.fill_between(x, y, color=colors_cell_count[state], alpha=0.2)\n",
    "    \n",
    "    # Mark maxima\n",
    "    if len(extrema_info[state]['maxima_window_idx']) > 0:\n",
    "        ax.scatter(extrema_info[state]['maxima_pseudotime'],\n",
    "                  extrema_info[state]['maxima_count'],\n",
    "                  color=colors_cell_count[state], s=150, marker='^',\n",
    "                  edgecolor='black', linewidth=2, zorder=5)\n",
    "    \n",
    "    # Mark minima\n",
    "    if len(extrema_info[state]['minima_window_idx']) > 0:\n",
    "        ax.scatter(extrema_info[state]['minima_pseudotime'],\n",
    "                  extrema_info[state]['minima_count'],\n",
    "                  color=colors_cell_count[state], s=150, marker='v',\n",
    "                  edgecolor='black', linewidth=2, zorder=5)\n",
    "\n",
    "ax.set_xlabel('Branch (pseudotime)')\n",
    "ax.set_ylabel('Cell Count')\n",
    "ax.set_title('Cell Counts with Extrema (▲=maxima, ▼=minima)')\n",
    "ax.legend(bbox_to_anchor=(1.05, 1), loc='upper left')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
