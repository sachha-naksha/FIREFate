    "                verticalalignment='center')\n",
    "\n",
    "plt.xlabel('Pseudotime')\n",
    "plt.ylabel('Log (CPM)')\n",
    "#save the figure\n",
    "plt.savefig(os.path.join(config.OUTPUT_FOLDER, 'gc_2nd_wave_tfs_expression.pdf'), dpi=300)\n",
    "plt.show()"
   ]
