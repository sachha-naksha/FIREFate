    "        line = plt.plot(exp_curves_dx, exp_curves_dy.loc[gene], linewidth=2, color=color)\n",
    "        # Add label at the end of the line\n",
    "        plt.text(exp_curves_dx.iloc[-1], exp_curves_dy.loc[gene].iloc[-1], f' {gene}', \n",
